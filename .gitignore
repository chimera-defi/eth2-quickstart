# User config (generated by tests or configure.sh)
config/user_config.env

# Cloned by install scripts (erigon.sh, reth.sh)
erigon/
reth/

# Installation logs (run_1, run_2)
logs/

# Package artifacts (chrony, etc.)
*.deb

# CI poll snapshots
status/*.json

# Audit working artifacts (raw delegate output; committed report lives in docs/audit/)
artifacts/

# Python bytecode cache
__pycache__/

.DS_store

# Agent-local skill symlinks (absolute paths; not portable across machines)
skills/token-reduce

# Token-reduce scratch state
.claude/token-reduce-state/
