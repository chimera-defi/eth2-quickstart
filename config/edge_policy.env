#!/bin/bash
# Shared edge-policy patterns for NGINX and Caddy renderer.
# Loaded by install/web/proxy_config_renderer.sh.

export PROXY_RPC_READ_METHODS_REGEX="${PROXY_RPC_READ_METHODS_REGEX:-eth_chainId|net_version|web3_clientVersion|eth_blockNumber|eth_getBlockByNumber|eth_getBlockByHash|eth_getTransactionByHash|eth_getTransactionReceipt|eth_getBalance|eth_getCode|eth_getStorageAt|eth_call|eth_estimateGas|eth_getLogs|eth_feeHistory|eth_gasPrice}"
export PROXY_RPC_WRITE_METHODS_REGEX="${PROXY_RPC_WRITE_METHODS_REGEX:-eth_sendRawTransaction|eth_sendTransaction|personal_sendTransaction|engine_[[:alnum:]_]+|admin_[[:alnum:]_]+|miner_[[:alnum:]_]+|txpool_[[:alnum:]_]+|debug_[[:alnum:]_]+}"
export PROXY_SPAM_EXTENSIONS_REGEX="${PROXY_SPAM_EXTENSIONS_REGEX:-m3u8|m3u|php|asp|aspx|jsp|cgi|pl|env|git|bak|ini|sql|sqlite|tar|gz|zip}"
export PROXY_ATTACK_PATHS_REGEX="${PROXY_ATTACK_PATHS_REGEX:-admin|wp-admin|wp-login|\\.env|config|cgi-bin|phpmyadmin|boaform|HNAP1|xmlrpc\\.php}"

# Shared anti-abuse thresholds (rendered into both Nginx and Caddy policies)
export EDGE_RPC_RATE_LIMIT_RPM="${EDGE_RPC_RATE_LIMIT_RPM:-50}"
export EDGE_WS_RATE_LIMIT_RPM="${EDGE_WS_RATE_LIMIT_RPM:-20}"
export EDGE_GENERAL_RATE_LIMIT_RPM="${EDGE_GENERAL_RATE_LIMIT_RPM:-100}"
export EDGE_RPC_BURST="${EDGE_RPC_BURST:-10}"
export EDGE_WS_BURST="${EDGE_WS_BURST:-5}"
export EDGE_RPC_CONN_LIMIT_PER_IP="${EDGE_RPC_CONN_LIMIT_PER_IP:-30}"
export EDGE_WS_CONN_LIMIT_PER_IP="${EDGE_WS_CONN_LIMIT_PER_IP:-20}"
