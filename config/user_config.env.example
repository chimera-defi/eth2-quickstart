# shellcheck shell=bash
# Example User Configuration for Eth2 Quick Start
# This file is auto-generated by configure.sh
# Copy this to user_config.env and customize as needed
#
# These values override defaults in exports.sh - only set what you want to change

# Chain selection (uncomment and set to 'monad' for Monad full node)
# Valid values: ethereum, monad
# export CHAIN='ethereum'

# REQUIRED for Monad: path to a dedicated, empty NVMe device for TrieDB state storage.
# WARNING: This device will be completely reformatted. Do NOT use your OS drive.
# Use 'lsblk' to identify the correct device. Verify it has no mountpoints.
# export MONAD_TRIEDB_DRIVE='/dev/nvme1n1'

# Network Selection (mainnet or holesky)
export ETH_NETWORK='mainnet'

# Your ETH address for validator rewards (CHANGE THIS!)
# Default from exports.sh shown below - replace with YOUR address
export FEE_RECIPIENT='0xa1feaF41d843d53d0F6bEd86a8cF592cE21C409e'

# Validator graffiti (shown on proposed blocks, max 32 bytes)
# Default from exports.sh
export GRAFITTI='SharedStake.org!'

# Selected Clients (set by configure.sh or manually)
# Execution: geth, erigon, reth, nethermind, besu, nimbus_eth1, ethrex
# Consensus: prysm, lighthouse, teku, nimbus, lodestar, grandine
export EXEC_CLIENT='geth'
export CONS_CLIENT='prysm'

# MEV Configuration (mev-boost, commit-boost, or none)
# mev-boost: Industry standard, stable, recommended
# commit-boost: Experimental modular alternative
export MEV_SOLUTION='mev-boost'

# Optional: Override max peers (default: 100)
# export MAX_PEERS=100

# Optional: Override checkpoint sync URL
# export PRYSM_CPURL='https://beaconstate.ethstaker.cc'

# Optional: Edge proxy tuning (applies to both NGINX and Caddy)
# Comma-separated upstream host:port backends (single backend shown)
# export EDGE_RPC_UPSTREAMS='127.0.0.1:8545'
# export EDGE_WS_UPSTREAMS='127.0.0.1:8546'
# export EDGE_LB_POLICY='least_conn'           # least_conn | ip_hash
# export EDGE_UPSTREAM_KEEPALIVE='64'
# export EDGE_DNS_RESOLVER=''                  # e.g. '1.1.1.1 8.8.8.8'
# export EDGE_TRUSTED_PROXIES=''               # e.g. '173.245.48.0/20,103.21.244.0/22'
# export EDGE_ENABLE_METRICS='true'
# export EDGE_METRICS_PATH='/metrics'
# export EDGE_ENABLE_COMPRESSION='true'
# Shared anti-abuse limits (used by both Nginx + Caddy renderers)
# export EDGE_RPC_RATE_LIMIT_RPM='50'
# export EDGE_WS_RATE_LIMIT_RPM='20'
# export EDGE_GENERAL_RATE_LIMIT_RPM='100'
# export EDGE_RPC_BURST='10'
# export EDGE_WS_BURST='5'
# export EDGE_RPC_CONN_LIMIT_PER_IP='30'
# export EDGE_WS_CONN_LIMIT_PER_IP='20'
# export EDGE_RPC_CACHE_MIN_USES='1'

# Optional: Caddy retry/failover tuning
# export CADDY_LB_POLICY='least_conn'
# export CADDY_LB_RETRIES='2'
# export CADDY_LB_TRY_DURATION='5s'
# export CADDY_LB_TRY_INTERVAL='250ms'
# export CADDY_FAIL_DURATION='30s'
# export CADDY_MAX_FAILS='3'
# export CADDY_ENSURE_MODULES='true'           # bootstrap required Caddy modules during install_caddy
# export CADDY_REQUIRED_MODULES='http.handlers.rate_limit,dns.providers.cloudflare'
# export CADDY_REQUIRED_PACKAGES='github.com/mholt/caddy-ratelimit,github.com/caddy-dns/cloudflare'
# export CADDY_INSTALL_ENFORCE_RATE_LIMIT='true' # install_caddy forces rate-limit availability
# export CADDY_REQUIRE_RATE_LIMIT='false'      # true = fail if rate_limit cannot be enabled
# export CADDY_REQUIRE_DNS_CHALLENGE='false'   # true = fail if dns.providers.cloudflare/token unavailable

# Optional: Disable Snort IDS profile during Phase 1 hardening (enabled by default)
# Note: Ubuntu package is Snort 2.x and adds packet-inspection overhead. Disable if this is not desired.
# export ENABLE_SNORT='false'
# export SNORT_INTERFACE='auto'              # e.g., eth0
# export SNORT_HOME_NET=''                   # e.g., 10.10.0.0/16 (empty = auto-detect)
# export SNORT_STARTUP='boot'                # boot | manual
# export SNORT_DISABLE_PROMISCUOUS='true'    # true for host-only traffic inspection
