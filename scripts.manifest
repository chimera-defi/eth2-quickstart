# Eth2 Quick Start - Scripts & Tools Manifest
# Format: path :: category :: description :: usage :: flags :: requires [:: quick_ref]
# Categories: core, maintenance, diagnostics, configuration, optional, ssl_web, mev, security, examples
# requires: root, non_root, or empty
# quick_ref: optional 7th field; if present, script appears in "Post-install: keep your node healthy" section

# === CORE INSTALLATION ===
run_1.sh :: core :: Phase 1: System hardening. Run as root, then reboot. :: sudo ./run_1.sh ::  :: root
run_2.sh :: core :: Phase 2: Client installation. Run as new user after Phase 1 + reboot. :: ./run_2.sh :: --execution=NAME --consensus=NAME --mev=NAME --skip-deps :: non_root
install_phase1.sh :: core :: Phase 1 (generated by configure.sh). Run as root. :: sudo ./install_phase1.sh ::  :: root
install_phase2.sh :: core :: Phase 2 (generated by configure.sh). Run as new user. :: ./install_phase2.sh ::  :: non_root
install.sh :: core :: Bootstrap: clone repo and launch configure wizard. :: curl -fsSL URL/install.sh | sudo bash :: --vibe :: root
install/utils/configure.sh :: core :: TUI wizard: generates phase scripts and user config. :: ./install/utils/configure.sh :: --vibe :: 

# === MAINTENANCE ===
install/utils/update.sh :: maintenance :: Update Ethereum clients (geth, prysm, MEV-Boost). :: ./install/utils/update.sh ::  ::  :: quick_ref
install/utils/update_all.sh :: maintenance :: Update both repo and software stack. :: ./install/utils/update_all.sh :: --git-only --software-only --backup --force --rollback :: 
install/utils/update_git.sh :: maintenance :: Update eth2-quickstart from git. :: ./install/utils/update_git.sh :: --backup --force --rollback :: 
install/utils/refresh.sh :: maintenance :: Restart all Ethereum services. :: ./install/utils/refresh.sh ::  ::  :: quick_ref
install/utils/start.sh :: maintenance :: Start all Ethereum client systemd services. :: ./install/utils/start.sh ::  ::  :: quick_ref

# === DIAGNOSTICS ===
install/utils/doctor.sh :: diagnostics :: Health check: system, services, config, ports, JWT. :: ./install/utils/doctor.sh ::  ::  :: quick_ref
install/utils/stats.sh :: diagnostics :: Client versions, service status, error scan. :: ./install/utils/stats.sh ::  ::  :: quick_ref
install/utils/view_logs.sh :: diagnostics :: View run_1, run_2, security logs. :: ./install/utils/view_logs.sh :: --list --run1 --run2 --security -n N -f ::  :: quick_ref
install/utils/verify_client_configs.sh :: diagnostics :: Verify client config files resolve correctly. :: ./install/utils/verify_client_configs.sh ::  :: 

# === CONFIGURATION ===
install/utils/select_clients.sh :: configuration :: Client recommendations by hardware profile. :: ./install/utils/select_clients.sh ::  :: 
install/utils/run_manifest.sh :: configuration :: Phase-aware runner. Auto-detects or force phase. :: ./install/utils/run_manifest.sh :: --phase1 --phase2 --dry-run :: 

# === OPTIONAL & ADVANCED ===
install/utils/optional_tools.sh :: optional :: Network monitoring (bmon, slurm, tcptrack). :: ./install/utils/optional_tools.sh ::  :: 
install/utils/purge_ethereum_data.sh :: optional :: Remove client data for clean client switch. Destructive. :: ./install/utils/purge_ethereum_data.sh :: --confirm --dry-run :: non_root
install/utils/install_dependencies.sh :: optional :: Install apt packages. Used by run_2, can run standalone. :: ./install/utils/install_dependencies.sh :: --test --base --production :: root

# === SSL & WEB ===
install/ssl/install_acme_ssl.sh :: ssl_web :: SSL via acme.sh (recommended). :: ./install/ssl/install_acme_ssl.sh ::  :: root
install/ssl/install_ssl_certbot.sh :: ssl_web :: SSL via Certbot. :: ./install/ssl/install_ssl_certbot.sh ::  :: root
install/web/install_nginx.sh :: ssl_web :: Nginx HTTP only. :: ./install/web/install_nginx.sh ::  :: 
install/web/install_caddy.sh :: ssl_web :: Caddy web server. :: ./install/web/install_caddy.sh ::  :: 
install/web/install_nginx_ssl.sh :: ssl_web :: Nginx with SSL configuration. :: ./install/web/install_nginx_ssl.sh ::  :: 
install/web/install_caddy_ssl.sh :: ssl_web :: Caddy with SSL configuration. :: ./install/web/install_caddy_ssl.sh ::  :: 

# === MEV ===
install/mev/install_mev_boost.sh :: mev :: MEV-Boost (relay-based, recommended). :: ./install/mev/install_mev_boost.sh ::  :: 
install/mev/install_commit_boost.sh :: mev :: Commit-Boost (experimental, replaces MEV-Boost). :: ./install/mev/install_commit_boost.sh ::  :: 
install/mev/install_ethgas.sh :: mev :: ETHGas (preconfirmation protocol). :: ./install/mev/install_ethgas.sh ::  :: 

# === SECURITY VERIFICATION ===
docs/verify_security.sh :: security :: Verify security configuration. :: ./docs/verify_security.sh ::  :: 
docs/server_security_validation.sh :: security :: Comprehensive security validation. :: ./docs/server_security_validation.sh ::  :: 
docs/validate_security_safe.sh :: security :: Validate security without root. Safe for non-privileged run. :: ./docs/validate_security_safe.sh ::  :: non_root

# === EXAMPLES (reference) ===
install/examples/run_prysm_checkpt_sync.sh :: examples :: Prysm checkpoint sync example. One-time manual sync. :: ./install/examples/run_prysm_checkpt_sync.sh ::  :: 
