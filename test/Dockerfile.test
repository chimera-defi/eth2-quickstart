# Dockerfile for Ethereum Node Setup Script Testing
# Provides isolated environment for safe testing of installation scripts

FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install essential packages for testing
RUN apt-get update && apt-get install -y \
    # Core utilities
    curl \
    wget \
    git \
    unzip \
    jq \
    # Shell testing tools
    shellcheck \
    bats \
    # Build tools (for testing client builds)
    build-essential \
    cmake \
    pkg-config \
    # Runtime dependencies
    python3 \
    python3-pip \
    nodejs \
    npm \
    openjdk-17-jdk-headless \
    # Network utilities
    netcat-openbsd \
    net-tools \
    iproute2 \
    # System utilities (mocked in tests)
    sudo \
    systemd \
    ufw \
    fail2ban \
    nginx \
    # SSL/crypto tools
    openssl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create test user matching the default LOGIN_UNAME
RUN useradd -m -s /bin/bash eth \
    && echo "eth ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/eth \
    && chmod 440 /etc/sudoers.d/eth

# Create necessary directories
RUN mkdir -p /home/eth/secrets \
    && mkdir -p /home/eth/prysm \
    && mkdir -p /home/eth/geth \
    && mkdir -p /var/log/nginx \
    && mkdir -p /etc/nginx/sites-available \
    && mkdir -p /etc/nginx/sites-enabled \
    && chown -R eth:eth /home/eth

# Set working directory
WORKDIR /workspace

# Copy the entire project
COPY --chown=eth:eth . /workspace/

# Make all scripts executable
RUN find /workspace -name "*.sh" -type f -exec chmod +x {} \;

# Create test results directory
RUN mkdir -p /workspace/test/results \
    && chown -R eth:eth /workspace/test

# Default to running tests as eth user
USER eth

# Set environment for testing
ENV HOME=/home/eth
ENV TEST_MODE=true

# Default command runs the test harness
CMD ["/workspace/test/run_tests.sh"]
